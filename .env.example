# SLM Router Service Configuration
ROUTER_BASE_URL=http://localhost:8000
ROUTER_ROUTE_ENDPOINT=/route
ROUTER_TIMEOUT_SECONDS=5.0

# Memory Storage Configuration
MEMORY_STORAGE_PATH=data/memory.json

# Environment & Logging
ENVIRONMENT=development
LOG_LEVEL=INFO

# Cloud Provider Stub Mode (Phase 1)
CLOUD_PROVIDER_STUB_MODE=true
