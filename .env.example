# SLM Router Service Configuration
ROUTER_BASE_URL=http://localhost:8008
ROUTER_ROUTE_ENDPOINT=/route
ROUTER_TIMEOUT_SECONDS=15.0

# Memory Storage Configuration
MEMORY_STORAGE_PATH=data/memory.json

# Environment & Logging
ENVIRONMENT=development
LOG_LEVEL=INFO

# Cloud Provider Stub Mode (Phase 1 legacy)
CLOUD_PROVIDER_STUB_MODE=true

# Local Answer Generation (Phase 4)
LOCAL_ANSWER_MODEL=Qwen/Qwen2.5-1.5B-Instruct
LOCAL_GENERATION_MAX_TOKENS=128
LOCAL_GENERATION_TEMPERATURE=0.0

# Cloud Answer Generation (Gemini - Phase 4)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TIMEOUT_SECONDS=15.0
